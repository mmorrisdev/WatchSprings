<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:background="#520F72"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/mainScrollView"
        tools:context=".MainActivity"
        tools:deviceIds="wear"
        android:padding="@dimen/box_inset_layout_padding">

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/inner_frame_layout_padding">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="fill_vertical"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hello_world"
                    android:layout_gravity="center_horizontal"/>

        <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1">
        </Space>


            <TableLayout
                    android:id="@+id/tableView"
                    android:background="@color/purplebg"
                    android:shrinkColumns="0"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:gravity="center_horizontal"
                    android:layout_height="wrap_content">

                <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" >

                    <ImageView
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:layout_weight="1"
                            android:maxHeight="180dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/title" />

                </TableRow>

                <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal">

                    <TextView
                            android:id="@+id/statusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STATUS"
                            android:gravity="center_horizontal"
                            android:textAlignment="center"
                            android:layout_gravity="center_horizontal"/>

                </TableRow>

                <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal">


                    <TextView
                            android:id="@+id/titleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Title Text"
                            android:background="#4D4284F2"
                            android:gravity="center_horizontal"
                            android:textAlignment="center"
                            android:layout_gravity="center_horizontal"/>

                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/newsButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="newsAction"
                            tools:textAllCaps="false"
                            android:text="Battle Royale News"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/stwNewsButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="stwNewsAction"
                            android:text="Save The World News"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/challengesButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="challengesAction"
                            android:text="Latest Challenges"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/storeButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="storeAction"
                            android:text="Daily Items"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/upcomingButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="upcomingAction"
                            android:text="Upcoming Items"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/weaponsButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="weaponsAction"
                            android:text="Weapons"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button android:id="@+id/reloadAllButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="reloadAction"
                            android:text="Reload All"/>
                </TableRow>

                <TableRow android:layout_width="match_parent"
                          android:layout_height="wrap_content"
                          android:gravity="center_horizontal">

                    <Button
                            android:id="@+id/aboutButton"
                            android:backgroundTint="@color/purplebuttonbg"
                            android:textAllCaps="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:onClick="aboutAction"
                            android:text="About"/>
                </TableRow>

            </TableLayout>

            <Space
                    android:layout_width="0dp"
                    android:layout_height="@dimen/table_footer"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1" >
            </Space>

        </LinearLayout>

    </FrameLayout>
</ScrollView>