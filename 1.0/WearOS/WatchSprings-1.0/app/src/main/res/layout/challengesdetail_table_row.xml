<?xml version="1.0" encoding="utf-8"?>

<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
          android:id="@+id/challengesdetail_table_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding = "5dp"
          android:gravity="center_horizontal">


    <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#007F40"
            android:orientation="vertical">

  	<TextView
                android:id="@+id/detailRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20dp"
                android:padding = "5dp"
                android:text="Challenge Detail Title"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:textAlignment="center"/>


        <ImageView
                android:id="@+id/detailRowImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="80dp"
                android:scaleType="fitXY"
                android:src="@drawable/starloading"
                android:layout_gravity="center_horizontal"/>

        <TextView
                android:id="@+id/detailRowBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:padding = "5dp"
                android:text="Challenge Detail Row Body"
                android:layout_gravity="center_horizontal"
                android:textAlignment="center"
                android:gravity="center_horizontal"/>


</LinearLayout>



</TableRow>
